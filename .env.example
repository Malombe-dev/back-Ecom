PORT=5000
MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Google Sign-In (from Google Cloud Console > OAuth 2.0 Client)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email (swap for Amazon SES or Resend SMTP creds in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Your Shop <no-reply@yourshop.com>"

# First super admin, created automatically on first server start if no super admin exists
SUPER_ADMIN_EMAIL=owner@yourshop.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
SUPER_ADMIN_NAME=Store Owner
